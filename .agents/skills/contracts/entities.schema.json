{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ATLAS Entities Schema",
  "type": "object",
  "definitions": {
    "claim": {
      "type": "object",
      "properties": {
        "owner": { "type": "string" },
        "task": { "type": "string" },
        "profile": { "type": "string", "enum": ["FAST", "STANDARD", "FULL"] },
        "write_scope": { "type": "array", "items": { "type": "string" } },
        "started_at": { "type": "string", "format": "date-time" },
        "status": { "type": "string" }
      },
      "required": ["owner", "task", "profile", "write_scope", "started_at", "status"]
    },
    "lease": {
      "type": "object",
      "properties": {
        "owner": { "type": "string" },
        "pid": { "type": "integer" },
        "acquired_at": { "type": "string", "format": "date-time" },
        "stale_lock_cap_seconds": { "type": "integer" },
        "purpose": { "type": ["string", "null"] }
      },
      "required": ["owner", "pid", "acquired_at", "stale_lock_cap_seconds"]
    },
    "signal": {
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "value": { "type": ["string", "number", "boolean", "object"] },
        "reason": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "value", "reason", "timestamp"]
    },
    "flow_state": {
      "type": "object",
      "properties": {
        "schema_version": { "type": "string", "const": "2.0" },
        "run_id": { "type": "string" },
        "feature_slug": { "type": "string" },
        "risk_profile": { "type": "string", "enum": ["FAST", "STANDARD", "FULL"] },
        "work_mode": { "type": "string", "enum": ["FEATURE", "BUGFIX", "PROTOTYPE", "REFACTOR", "DOCS"] },
        "stage": { "type": "string", "enum": ["align", "trace", "lay", "act", "settle"] },
        "status": { "type": "string", "enum": ["pending", "running", "done", "blocked", "needs_revision"] },
        "attempt": { "type": "integer", "minimum": 1 },
        "last_verified_commit": { "type": "string" },
        "completed_steps": { "type": "array", "items": { "type": "string" } },
        "pending_step": { "type": "string" },
        "locks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file": { "type": "string" },
              "acquired_at": { "type": "string", "format": "date-time" }
            },
            "required": ["file", "acquired_at"]
          }
        },
        "signals": { "type": "array", "items": { "$ref": "#/definitions/signal" } },
        "last_gate": { "type": ["string", "null"] },
        "last_gate_status": { "type": ["string", "null"], "enum": ["PASS", "FAIL", "BLOCKED", "NEEDS_HUMAN_REVIEW"] },
        "consecutive_failures": { "type": "integer", "minimum": 0 },
        "retry_count": { "type": "integer", "minimum": 0 },
        "verified_artifacts": { "type": "array", "items": { "type": "string" } }
      },
      "required": [
        "schema_version",
        "run_id",
        "feature_slug",
        "risk_profile",
        "work_mode",
        "stage",
        "status",
        "attempt",
        "completed_steps",
        "pending_step",
        "locks",
        "signals",
        "consecutive_failures",
        "retry_count",
        "verified_artifacts"
      ]
    }
  }
}
