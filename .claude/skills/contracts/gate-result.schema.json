{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Gate Result Envelope",
  "type": "object",
  "properties": {
    "stage_id": { "type": "string", "enum": ["align", "trace", "lay", "act", "settle"] },
    "status": { "type": "string", "enum": ["PASS", "FAIL", "BLOCKED", "NEEDS_HUMAN_REVIEW"] },
    "blocking": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "artifacts_produced": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["stage_id", "status", "blocking", "warnings", "artifacts_produced"]
}
